{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-internet-s-tip-jar",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-08",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "the-internets-tip-jar",
      "database_id": "92535257-7249-45b6-b72c-ea008ed5ae45",
      "migrations_dir": "migrations"
    }
  ]
}
